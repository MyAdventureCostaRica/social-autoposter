{"skip": false, "source": "IMG_2125.HEIC", "sources": ["IMG_2125.HEIC", "IMG_2126.HEIC", "IMG_2128.HEIC"], "base": "IMG_2125", "image_urls": ["https://raw.githubusercontent.com/MyAdventureCostaRica/social-autoposter/509654a8776340239489436deb877b908e217a91/rendered/IMG_2125_1.jpg", "https://raw.githubusercontent.com/MyAdventureCostaRica/social-autoposter/509654a8776340239489436deb877b908e217a91/rendered/IMG_2125_2.jpg", "https://raw.githubusercontent.com/MyAdventureCostaRica/social-autoposter/509654a8776340239489436deb877b908e217a91/rendered/IMG_2125_3.jpg"], "image_url": "https://raw.githubusercontent.com/MyAdventureCostaRica/social-autoposter/509654a8776340239489436deb877b908e217a91/rendered/IMG_2125_1.jpg", "story_url": "https://raw.githubusercontent.com/MyAdventureCostaRica/social-autoposter/509654a8776340239489436deb877b908e217a91/rendered/IMG_2125_story.jpg", "caption": "Gravel cycling in Costa Rica is at its best when the road climbs out of the valley and lets the wind take over. I look for routes like this when scouting: unhurried elevation, wide-open horizons, and miles of clean track where you rarely meet another soul. This is how we ride the interior \u2014 at the pace the terrain demands.\n\n#myadventurecostarica #gravelcycling #adventuretravel #luxurytravel #costaricatravel", "format": "carousel", "category": "CYCLING", "pillar": "ROUTE", "status": "pending", "ts": "2026-08-15T00:52:50"}